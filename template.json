    "Hub": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/formbricks.svg",
      "source": {
        "image": "ghcr.io/formbricks/hub:0.14.3@sha256:63b85da9a0eb4346dd9350cd2bc82e9fe00b195756ad9a4bd50195ba874d10bc"
      },
      "startCommand": "/bin/sh -c 'i=0; until wget -q -O /dev/null \"$FORMBRICKS_HEALTH_URL\"; do i=$((i+1)); if [ $i -ge 360 ]; then echo \"Formbricks not healthy after 30 minutes; exiting\"; exit 1; fi; echo \"waiting for Formbricks migrations ($i)\"; sleep 5; done; i=0; until /usr/local/bin/goose -dir /app/migrations postgres \"$DATABASE_URL\" up && /usr/local/bin/river migrate-up --database-url \"$DATABASE_URL\"; do i=$((i+1)); if [ $i -ge 60 ]; then echo \"Hub migrations still failing\"; exit 1; fi; sleep 5; done; exec /app/hub-api'",
      "preDeployCommand": null,
      "healthcheckPath": "/health",
      "healthcheckTimeout": 1800,
      "restartPolicyType": "ALWAYS",
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "PORT": {
          "defaultValue": "8080",
          "description": "Hub API port.",
          "required": false
        },
        "API_KEY": {
          "defaultValue": "${{Formbricks.HUB_API_KEY}}",
          "description": "API key Formbricks uses to call Hub.",
          "required": false
        },
        "DATABASE_URL": {
          "defaultValue": "postgresql://${{Postgres.POSTGRES_USER}}:${{Postgres.POSTGRES_PASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/${{Postgres.POSTGRES_DB}}?sslmode=disable",
          "description": "Shared Formbricks database (Hub tables live next to Formbricks').",
          "required": false
        },
        "DATABASE_MAX_CONNS": {
          "defaultValue": "10",
          "description": "Connection pool size.",
          "required": false
        },
        "LOG_LEVEL": {
          "defaultValue": "info",
          "description": "Log level.",
          "required": false
        },
        "LOG_FORMAT": {
          "defaultValue": "json",
          "description": "Log format.",
          "required": false
        },
        "FORMBRICKS_HEALTH_URL": {
          "defaultValue": "http://${{Formbricks.RAILWAY_PRIVATE_DOMAIN}}:3000/health",
          "description": "Hub waits for Formbricks (its migrations must run first on the shared database).",
          "required": false
        }
      }
